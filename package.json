{
  "name": "ghoststudent",
  "displayName": "Ghost Student",
  "description": "Real-time ghost code broadcasting for teachers and students.",
  "version": "1.0.0",
  "publisher": "golddeniel",
  "repository": {
    "type": "git",
    "url": "https://github.com/GoldDeniel/ghoststudent"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ghoststudent.connect",
        "title": "Ghost Student: Connect"
      },
      {
        "command": "ghoststudent.host",
        "title": "Ghost Student: Host"
      },
      {
        "command": "ghoststudent.toggle",
        "title": "Ghost Student: Toggle Broadcasting"
      },
      {
        "command": "ghoststudent.menu",
        "title": "Ghost Student: Menu"
      }
    ],
    "configuration": {
      "title": "Ghost Student",
      "properties": {
        "ghoststudent.autoCreateLines": {
          "type": "boolean",
          "default": true,
          "description": "Automatically insert empty lines in the student's file if the teacher creates new lines."
        },
        "ghoststudent.smartMatching": {
          "type": "boolean",
          "default": true,
          "description": "Intelligently handle auto-closed tags and brackets (e.g., injects ghost text inside <title></title>)."
        },
        "ghoststudent.errorDisplayMode": {
          "type": "string",
          "enum": [
            "Show Expected Comment",
            "Continue Ghost Text"
          ],
          "default": "Continue Ghost Text",
          "description": "How to display the teacher's code when the student makes a typo."
        },
        "ghoststudent.strictWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "If ON, tabs and spaces must match exactly. If OFF, ghost text snaps to the user's code and ignores indentation differences."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
